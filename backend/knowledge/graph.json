  "relationships": [
    {"id": "rel-hb-hct-rbc", "members": ["Hemoglobin", "Hematocrit", "Red Blood Cells"], "type": "interpreted_together",
     "description": "Hemoglobin, hematocrit and red blood cell count all describe red blood cells and are reported together in a complete blood count; abnormal levels of these measures can be associated with dehydration, anemia, heart disease or too little iron.",
     "evidence": ["mlp-cbc-2"]},
    {"id": "rel-rbc-indices", "members": ["Mean Corpuscular Volume", "Mean Corpuscular Hemoglobin", "MCHC", "Red Cell Distribution Width"], "type": "interpreted_together",
     "description": "The red blood cell indices (MCV, MCH, MCHC, RDW) describe the size and hemoglobin content of red cells and are interpreted together with other blood tests.",
     "evidence": ["mlp-rbc-indices-1", "mlp-rbc-indices-2"]},
    {"id": "rel-mcv-hb", "members": ["Mean Corpuscular Volume", "Hemoglobin", "Red Blood Cells"], "type": "interpreted_together",
     "description": "MCV is usually read together with the red blood cell count and hemoglobin; anemia can occur even when MCV is normal.",
     "evidence": ["mlp-mcv-2"]},
    {"id": "rel-mcv-b12", "members": ["Mean Corpuscular Volume", "Vitamin B12"], "type": "associated_with",
     "description": "Larger-than-normal red blood cells (high MCV) can be seen with low vitamin B12 or folate, among other causes.",
     "evidence": ["mlp-mcv-1"]},
    {"id": "rel-wbc-diff", "members": ["White Blood Cells", "Neutrophils", "Lymphocytes", "Monocytes", "Eosinophils", "Basophils"], "type": "component_of",
     "description": "The total white blood count is made up of five types of white cells, which a blood differential measures separately; the total count is usually read with the differential.",
     "evidence": ["mlp-differential-1", "mlp-wbc-2"]},
    {"id": "rel-kidney", "members": ["Blood Urea Nitrogen", "Serum Creatinine", "eGFR"], "type": "interpreted_together",
     "description": "BUN, creatinine and eGFR are all used to assess kidney function; eGFR is calculated from blood creatinine, and BUN is often considered alongside creatinine.",
     "evidence": ["mlp-bun-2", "mlp-creatinine-2", "mlp-egfr-1"]},
    {"id": "rel-electrolytes", "members": ["Sodium", "Potassium", "Chloride", "Bicarbonate"], "type": "interpreted_together",
     "description": "Sodium, potassium, chloride and bicarbonate are electrolytes usually measured and interpreted together; their levels can shift when the body's water balance changes.",
     "evidence": ["mlp-electrolytes-1", "mlp-electrolytes-2", "mlp-sodium-2"]},
    {"id": "rel-liver-enzymes", "members": ["ALT (SGPT)", "AST (SGOT)"], "type": "interpreted_together",
     "description": "ALT and AST are liver enzymes usually measured together; high ALT and/or AST may indicate some type of liver damage that providers assess with other tests.",
     "evidence": ["mlp-alt-2", "mlp-ast-2"]},
    {"id": "rel-liver-panel", "members": ["ALT (SGPT)", "AST (SGOT)", "Alkaline Phosphatase", "Total Bilirubin", "Albumin", "Total Protein"], "type": "interpreted_together",
     "description": "Liver function tests are compared together to look for patterns; liver tests alone usually cannot diagnose a specific disease and may be repeated after a recent illness.",
     "evidence": ["mlp-liver-panel-1", "mlp-alp-1"]},
    {"id": "rel-bilirubin", "members": ["Total Bilirubin", "Direct Bilirubin", "Indirect Bilirubin"], "type": "component_of",
     "description": "Bilirubin tests may report total, direct (conjugated) and indirect (unconjugated) bilirubin.",
     "evidence": ["mlp-bilirubin-1"]},
    {"id": "rel-proteins", "members": ["Total Protein", "Albumin", "Globulin", "A/G Ratio"], "type": "component_of",
     "description": "Total protein is mainly albumin plus globulins, and the A/G ratio compares the two.",
     "evidence": ["mlp-protein-ag-1"]},
    {"id": "rel-lipids", "members": ["Total Cholesterol", "HDL Cholesterol", "LDL Cholesterol", "VLDL Cholesterol", "Triglycerides"], "type": "interpreted_together",
     "description": "A lipid panel reports total cholesterol (which includes HDL and LDL), triglycerides and sometimes VLDL; risk is greater when high triglycerides occur with high LDL and/or low HDL.",
     "evidence": ["mlp-cholesterol-1", "mlp-triglycerides-2"]},
    {"id": "rel-thyroid", "members": ["TSH", "Free T4", "Free T3"], "type": "regulates",
     "description": "TSH from the pituitary tells the thyroid how much hormone to make; TSH usually rises when thyroid hormone is low and falls when it is high, so T4 and T3 are interpreted together with TSH.",
     "evidence": ["mlp-tsh-1", "mlp-t4-1", "mlp-t3-1"]},
    {"id": "rel-iron", "members": ["Ferritin", "Serum Iron", "Hemoglobin"], "type": "required_for",
     "description": "Iron is needed to make hemoglobin; ferritin reflects stored iron, serum iron reflects iron in the blood, and providers often order several iron tests together.",
     "evidence": ["mlp-iron-1", "mlp-ferritin-1"]},
    {"id": "rel-a1c-glucose", "members": ["HbA1c", "Fasting Glucose"], "type": "interpreted_together",
     "description": "HbA1c reflects average blood sugar over about two to three months, while a glucose test reflects one moment; a high A1C may be followed by a fasting glucose or other test.",
     "evidence": ["mlp-a1c-1", "mlp-a1c-2"]},
    {"id": "rel-a1c-hb", "members": ["HbA1c", "Hemoglobin"], "type": "affects_accuracy_of",
     "description": "Conditions that affect red blood cells, such as anemia, can make HbA1c results less accurate.",
     "evidence": ["mlp-a1c-3"]},
    {"id": "rel-inflammation", "members": ["ESR", "CRP"], "type": "interpreted_together",
     "description": "ESR and CRP are both markers of inflammation and a CRP test is often done with an ESR; neither identifies the cause of inflammation.",
     "evidence": ["mlp-esr-1", "mlp-crp-1"]},
    {"id": "rel-calcium-vitd", "members": ["Calcium", "Vitamin D"], "type": "associated_with",
     "description": "Vitamin D helps the body absorb calcium; too much vitamin D over time can be associated with high calcium, and too little with low calcium.",
     "evidence": ["mlp-vitamin-d-1", "mlp-calcium-2"]}
  ]
