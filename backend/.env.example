# Copy to backend/.env and fill in. Never commit the real .env.

# Google Gemini API key (https://aistudio.google.com/app/apikey). Leave empty to run without AI
# (the app then shows clearly labelled rule-based summaries).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# development | production
ENVIRONMENT=development

# Comma-separated frontend origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optional regex for preview deployments, e.g. https://medexplain-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Where uploads and extracted data are stored, and how long they are kept
DATA_DIR=
REPORT_RETENTION_HOURS=24

# OCR needs PaddleOCR (requirements-ocr.txt)
ENABLE_OCR=true

RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
